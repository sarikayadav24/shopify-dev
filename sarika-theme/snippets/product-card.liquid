<div class="product-card">

  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" class="product-card__image-link" aria-label="{{ product.title }}">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 600 | image_tag:
           class: 'product-card__image',
           loading: 'lazy',
           alt: product.featured_image.alt | default: product.title }}
      {% else %}
        <div class="product-card__no-image">
          <span>No Image</span>
        </div>
      {% endif %}
    </a>

    {% comment %} Badges {% endcomment %}
    <div class="product-card__badges">
      {% if product.compare_at_price > product.price %}
        <span class="product-card__badge product-card__badge--sale">Sale</span>
      {% endif %}
      {% unless product.available %}
        <span class="product-card__badge product-card__badge--soldout">Sold Out</span>
      {% endunless %}
    </div>

    {% comment %} Quick Add {% endcomment %}
    {% if product.available %}
      <div class="product-card__quick-add">
        <form action="/cart/add" method="post">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="product-card__quick-add-btn">
            Quick Add
          </button>
        </form>
      </div>
    {% endif %}

  </div>

  <div class="product-card__info">
    {% if product.vendor %}
      <p class="product-card__vendor">{{ product.vendor }}</p>
    {% endif %}

    <a href="{{ product.url }}" class="product-card__title-link">
      <h3 class="product-card__title">{{ product.title }}</h3>
    </a>

    <p class="product-card__price">
      {% if product.compare_at_price > product.price %}
        <span class="product-card__price--original">{{ product.compare_at_price | money }}</span>
        <span class="product-card__price--sale">{{ product.price | money }}</span>
      {% else %}
        <span>{{ product.price | money }}</span>
      {% endif %}
    </p>
  </div>

</div>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
  }

  /* Image */
  .product-card__image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background-color: var(--color-subtle);
    aspect-ratio: 3 / 4;
  }

  .product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .product-card:hover .product-card__image {
    transform: scale(1.04);
  }

  .product-card__no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-size: var(--font-size-sm);
  }

  /* Badges */
  .product-card__badges {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    z-index: 2;
  }

  .product-card__badge {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 8px;
  }

  .product-card__badge--sale {
    background-color: var(--color-sale);
    color: #fff;
  }

  .product-card__badge--soldout {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  /* Quick Add */
  .product-card__quick-add {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .product-card:hover .product-card__quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  .product-card__quick-add-btn {
    width: 100%;
    padding: 12px;
    background-color: var(--color-primary);
    color: var(--color-primary-text);
    border: none;
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .product-card__quick-add-btn:hover {
    background-color: var(--color-accent);
  }

  /* Info */
  .product-card__info {
    padding: var(--space-4) 0;
    flex: 1;
  }

  .product-card__vendor {
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-1);
  }

  .product-card__title-link {
    text-decoration: none;
    color: inherit;
  }

  .product-card__title {
    font-family: var(--font-body--family);
    font-size: var(--font-size-md);
    font-weight: 500;
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .product-card__price {
    font-size: var(--font-size-sm);
    color: var(--color-foreground);
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .product-card__price--original {
    text-decoration: line-through;
    color: var(--color-muted);
  }

  .product-card__price--sale {
    color: var(--color-sale);
    font-weight: 600;
  }
{% endstylesheet %}
