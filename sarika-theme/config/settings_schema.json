[
  {
    "name": "theme_info",
    "theme_name": "Sarika",
    "theme_version": "1.0.0",
    "theme_author": "Sarika Yadav",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Primary Font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Body Font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n4",
        "label": "Heading Font"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Base Font Size",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page Width",
        "options": [
          { "value": "1200px", "label": "Narrow (1200px)" },
          { "value": "1400px", "label": "Wide (1400px)" },
          { "value": "1600px", "label": "Full (1600px)" }
        ],
        "default": "1200px"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Page Margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 20,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Section Vertical Spacing",
        "default": 64
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand Colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "default": "#1a1a1a",
        "label": "Primary (Buttons, Links)"
      },
      {
        "type": "color",
        "id": "color_primary_text",
        "default": "#ffffff",
        "label": "Primary Text (on buttons)"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#c8a96e",
        "label": "Accent Color"
      },
      {
        "type": "header",
        "content": "Page Colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#ffffff",
        "label": "Page Background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#1a1a1a",
        "label": "Page Text"
      },
      {
        "type": "color",
        "id": "color_subtle",
        "default": "#f7f5f2",
        "label": "Subtle Background"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "#e8e4df",
        "label": "Border Color"
      },
      {
        "type": "color",
        "id": "color_muted",
        "default": "#888888",
        "label": "Muted Text"
      },
      {
        "type": "color",
        "id": "color_sale",
        "default": "#c0392b",
        "label": "Sale / Error Color"
      }
    ]
  },
  {
    "name": "Borders & Radius",
    "settings": [
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 12,
        "step": 1,
        "unit": "px",
        "label": "Input Corner Radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Button Corner Radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "Card Corner Radius",
        "default": 0
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "select",
        "id": "button_style",
        "label": "Button Style",
        "options": [
          { "value": "filled", "label": "Filled" },
          { "value": "outlined", "label": "Outlined" }
        ],
        "default": "filled"
      }
    ]
  }
]
