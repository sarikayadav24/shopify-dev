<footer class="site-footer" style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};">
  <div class="site-footer__inner">

    {% comment %} Column 1 — Brand {% endcomment %}
    <div class="site-footer__brand">
      {% if section.settings.logo %}
        <a href="{{ routes.root_url }}" class="site-footer__logo-link">
          {{ section.settings.logo | image_url: width: 160 | image_tag: class: 'site-footer__logo', alt: shop.name }}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="site-footer__store-name">{{ shop.name }}</a>
      {% endif %}

      {% if section.settings.brand_description != blank %}
        <p class="site-footer__description">{{ section.settings.brand_description }}</p>
      {% endif %}

      {% comment %} Social icons {% endcomment %}
      <div class="site-footer__social">
        {% if section.settings.social_instagram != blank %}
          <a href="{{ section.settings.social_instagram }}" class="site-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
            </svg>
          </a>
        {% endif %}
        {% if section.settings.social_facebook != blank %}
          <a href="{{ section.settings.social_facebook }}" class="site-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
        {% endif %}
        {% if section.settings.social_pinterest != blank %}
          <a href="{{ section.settings.social_pinterest }}" class="site-footer__social-link" aria-label="Pinterest" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.236 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.181-.78 1.172-4.97 1.172-4.97s-.299-.598-.299-1.482c0-1.388.806-2.428 1.808-2.428.853 0 1.267.64 1.267 1.408 0 .858-.546 2.140-.828 3.33-.236.995.499 1.806 1.476 1.806 1.771 0 3.135-1.867 3.135-4.561 0-2.384-1.714-4.052-4.161-4.052-2.834 0-4.498 2.126-4.498 4.322 0 .856.33 1.772.741 2.273a.3.3 0 01.069.286c-.076.315-.244.995-.277 1.134-.044.183-.145.222-.335.134-1.249-.581-2.03-2.407-2.03-3.874 0-3.154 2.292-6.052 6.608-6.052 3.469 0 6.165 2.473 6.165 5.776 0 3.447-2.173 6.22-5.19 6.22-1.013 0-1.966-.527-2.292-1.148l-.623 2.378c-.226.869-.835 1.958-1.244 2.621.937.29 1.931.446 2.962.446 5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
            </svg>
          </a>
        {% endif %}
        {% if section.settings.social_tiktok != blank %}
          <a href="{{ section.settings.social_tiktok }}" class="site-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>

    {% comment %} Column 2 — Nav links {% endcomment %}
    {% if section.settings.menu_1 != blank %}
      <div class="site-footer__nav">
        {% if section.settings.menu_1_heading != blank %}
          <h3 class="site-footer__nav-heading">{{ section.settings.menu_1_heading }}</h3>
        {% endif %}
        <ul class="site-footer__nav-list">
          {% for link in section.settings.menu_1.links %}
            <li><a href="{{ link.url }}" class="site-footer__nav-link">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% comment %} Column 3 — Help links {% endcomment %}
    {% if section.settings.menu_2 != blank %}
      <div class="site-footer__nav">
        {% if section.settings.menu_2_heading != blank %}
          <h3 class="site-footer__nav-heading">{{ section.settings.menu_2_heading }}</h3>
        {% endif %}
        <ul class="site-footer__nav-list">
          {% for link in section.settings.menu_2.links %}
            <li><a href="{{ link.url }}" class="site-footer__nav-link">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% comment %} Column 4 — Newsletter {% endcomment %}
    <div class="site-footer__newsletter">
      {% if section.settings.newsletter_heading != blank %}
        <h3 class="site-footer__nav-heading">{{ section.settings.newsletter_heading }}</h3>
      {% endif %}
      {% if section.settings.newsletter_subtext != blank %}
        <p class="site-footer__newsletter-subtext">{{ section.settings.newsletter_subtext }}</p>
      {% endif %}
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="site-footer__newsletter-form">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.newsletter_placeholder }}"
            class="site-footer__newsletter-input"
            required
            aria-label="Email address"
          >
          <button type="submit" class="btn btn--primary site-footer__newsletter-btn">
            {{ section.settings.newsletter_btn_label }}
          </button>
        </div>
      {% endform %}
    </div>

  </div>

  {% comment %} Bottom bar {% endcomment %}
  <div class="site-footer__bottom">
    <div class="site-footer__bottom-inner">
      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
      <div class="site-footer__payment">
        {% if section.settings.show_payment_icons %}
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>

</footer>

{% stylesheet %}
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
  }

  .site-footer__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-16) var(--page-margin);
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr;
    gap: var(--space-10);
  }

  @media (max-width: 900px) {
    .site-footer__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }

  /* Brand column */
  .site-footer__store-name {
    font-size: var(--font-size-xl);
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    text-decoration: none;
    color: inherit;
    display: block;
    margin-bottom: var(--space-4);
  }

  .site-footer__logo {
    height: 36px;
    width: auto;
    margin-bottom: var(--space-4);
  }

  .site-footer__description {
    font-size: var(--font-size-sm);
    line-height: 1.7;
    opacity: 0.7;
    margin-bottom: var(--space-5);
    max-width: 260px;
  }

  /* Social */
  .site-footer__social {
    display: flex;
    gap: var(--space-4);
  }

  .site-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    opacity: 0.6;
    transition: opacity var(--transition-fast);
    color: inherit;
  }

  .site-footer__social-link:hover {
    opacity: 1;
  }

  .site-footer__social-link svg {
    width: 20px;
    height: 20px;
  }

  /* Nav columns */
  .site-footer__nav-heading {
    font-family: var(--font-body--family);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-5);
    opacity: 0.5;
  }

  .site-footer__nav-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .site-footer__nav-link {
    font-size: var(--font-size-sm);
    text-decoration: none;
    color: inherit;
    opacity: 0.7;
    transition: opacity var(--transition-fast);
  }

  .site-footer__nav-link:hover {
    opacity: 1;
  }

  /* Newsletter */
  .site-footer__newsletter-subtext {
    font-size: var(--font-size-sm);
    opacity: 0.7;
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }

  .site-footer__newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__newsletter-input {
    width: 100%;
    padding: 12px var(--space-4);
    border: 1px solid var(--color-border);
    background-color: transparent;
    color: inherit;
    font-size: var(--font-size-sm);
    border-radius: var(--radius-input);
  }

  .site-footer__newsletter-input::placeholder {
    opacity: 0.5;
  }

  .site-footer__newsletter-btn {
    width: 100%;
  }

  /* Bottom bar */
  .site-footer__bottom {
    border-top: 1px solid var(--color-border);
    padding: var(--space-5) var(--page-margin);
  }

  .site-footer__bottom-inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .site-footer__copyright {
    font-size: var(--font-size-xs);
    opacity: 0.5;
  }

  .site-footer__payment {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex-wrap: wrap;
  }

  .payment-icon {
    height: 24px;
    width: auto;
    opacity: 0.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Curated pieces for the modern wardrobe. Quality you can feel."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Navigation Column 1"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Column 1 Heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Navigation Column 2"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Column 2 Heading",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 2 Menu"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter Subtext",
      "default": "New arrivals, exclusive offers and style tips — straight to your inbox."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input Placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "newsletter_btn_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    }
  ]
}
{% endschema %}
