<div class="hero"
     style="min-height: {{ section.settings.min_height }}px; color: {{ section.settings.text_color }};">

  {% if section.settings.image %}
    <div class="hero__bg">
      {{ section.settings.image | image_url: width: 2000 | image_tag:
         class: 'hero__bg-img',
         loading: 'eager',
         fetchpriority: 'high',
         alt: section.settings.heading }}
    </div>
  {% endif %}

  <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div class="hero__content hero__content--{{ section.settings.alignment }}">

    {% if section.settings.eyebrow != blank %}
      <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}

    <h1 class="hero__heading">{{ section.settings.heading }}</h1>

    {% if section.settings.subtext != blank %}
      <p class="hero__subtext">{{ section.settings.subtext }}</p>
    {% endif %}

    <div class="hero__buttons">
      {% if section.settings.cta_primary_label != blank %}
        <a href="{{ section.settings.cta_primary_url }}" class="btn btn--primary">
          {{ section.settings.cta_primary_label }}
        </a>
      {% endif %}
      {% if section.settings.cta_secondary_label != blank %}
        <a href="{{ section.settings.cta_secondary_url }}" class="btn btn--ghost">
          {{ section.settings.cta_secondary_label }}
        </a>
      {% endif %}
    </div>

  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-subtle);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: #000;
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-20) var(--page-margin);
  }

  .hero__content--center { text-align: center; }
  .hero__content--left   { text-align: left; }
  .hero__content--right  { text-align: right; }

  .hero__eyebrow {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .hero__heading {
    font-size: var(--font-size-4xl);
    line-height: 1.1;
    max-width: 700px;
    margin-bottom: var(--space-5);
  }

  .hero__content--center .hero__heading,
  .hero__content--center .hero__subtext {
    margin-left: auto;
    margin-right: auto;
  }

  .hero__subtext {
    font-size: var(--font-size-lg);
    max-width: 520px;
    margin-bottom: var(--space-8);
    opacity: 0.9;
    line-height: 1.6;
  }

  .hero__buttons {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero__content--center .hero__buttons {
    justify-content: center;
  }

  .hero__content--right .hero__buttons {
    justify-content: flex-end;
  }

  /* Ghost button needs white border when on dark hero */
  .hero .btn--ghost {
    border-color: currentColor;
    color: inherit;
  }

  .hero .btn--ghost:hover {
    background-color: rgba(255,255,255,0.15);
  }

  @media (max-width: 768px) {
    .hero__heading {
      font-size: var(--font-size-3xl);
    }
    .hero__buttons {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__buttons .btn {
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Style That Speaks"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover our latest arrivals — crafted for everyday elegance."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary Button Label",
      "default": "View Lookbook"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum Height (px)",
      "min": 400,
      "max": 900,
      "step": 50,
      "default": 600
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
