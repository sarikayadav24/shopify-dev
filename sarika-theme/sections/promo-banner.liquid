<div class="promo-banner" style="background-color: {{ section.settings.background_color }};">
  {% if section.settings.background_image %}
    <div class="promo-banner-bg">
      {{ section.settings.background_image | image_url: width: 1500 | image_tag: class: 'promo-banner-img' }}
    </div>
  {% endif %}

  <div class="promo-banner-content" style="text-align: {{ section.settings.text_alignment }};">
    <h2 class="promo-banner-heading">{{ section.settings.heading }}</h2>

    <div class="promo-banner-subtext">
      {{ section.settings.subtext }}
    </div>

    {% if section.settings.show_button %}
      <a href="{{ section.settings.button_link }}" class="btn btn--primary">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .promo-banner {
    position: relative;
    padding: var(--section-spacing) var(--page-margin);
    overflow: hidden;
  }

  .promo-banner-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .promo-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .promo-banner-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
  }

  .promo-banner-heading {
    font-size: var(--font-size-3xl);
    margin-bottom: 1rem;
  }

  .promo-banner-subtext {
    font-size: var(--font-size-md);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Promo Banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Big Sale This Weekend!"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Use code <strong>SAVE20</strong> at checkout for 20% off everything.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#fef3c7"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}
