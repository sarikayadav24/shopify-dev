<div class="contact">
  <div class="contact__inner">

    <div class="section-header">
      {% if section.settings.eyebrow != blank %}
        <span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1 class="section-header__title">{{ section.settings.heading }}</h1>
      {% if section.settings.subtext != blank %}
        <p class="section-header__subtitle">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    {% form 'contact' %}

      {% comment %} Success message after submit {% endcomment %}
      {% if form.posted_successfully? %}
        <p class="contact__success">{{ section.settings.success_message }}</p>
      {% endif %}

      {% comment %} Error messages {% endcomment %}
      {% if form.errors %}
        <div class="contact__errors">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="contact__row">
        <div class="contact__field">
          <label for="contact-name" class="contact__label">Name</label>
          <input type="text" id="contact-name" name="contact[name]" class="contact__input" required>
        </div>
        <div class="contact__field">
          <label for="contact-email" class="contact__label">Email</label>
          <input type="email" id="contact-email" name="contact[email]" class="contact__input" required>
        </div>
      </div>

      <div class="contact__field">
        <label for="contact-phone" class="contact__label">Phone</label>
        <input type="tel" id="contact-phone" name="contact[phone]" class="contact__input" required>
      </div>

      <div class="contact__field">
        <label for="contact-body" class="contact__label">Message</label>
        <textarea id="contact-body" name="contact[body]" rows="6" class="contact__textarea" required></textarea>
      </div>

      <button type="submit" class="btn btn--primary">{{ section.settings.button_label }}</button>

    {% endform %}

  </div>
</div>

{% stylesheet %}
  .contact {
    padding: var(--section-spacing) var(--page-margin);
  }

  .contact__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .contact__success {
    background-color: var(--color-subtle);
    color: var(--color-foreground);
    padding: var(--space-4);
    margin-bottom: var(--space-6);
    border-left: 3px solid var(--color-accent);
  }

  .contact__errors {
    color: var(--color-sale);
    margin-bottom: var(--space-6);
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  @media (max-width: 600px) {
    .contact__row {
      grid-template-columns: 1fr;
    }
  }

  .contact__field {
    margin-bottom: var(--space-4);
  }

  .contact__label {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .contact__input,
  .contact__textarea {
    width: 100%;
    padding: 12px var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    font-size: var(--font-size-md);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .contact__input:focus,
  .contact__textarea:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .contact__textarea {
    resize: vertical;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Get In Touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Have a question? Send us a message and we'll get back to you soon."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Send Message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thanks for reaching out — we'll be in touch shortly."
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
