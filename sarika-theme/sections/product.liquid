{% assign current_variant = product.selected_or_first_available_variant %}

<div class="product-page">
  <div class="product-page__inner">

    {% comment %} Gallery {% endcomment %}
    <div class="product-gallery">

      <div class="product-gallery__main">
        <img
          id="product-main-image"
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.featured_image.alt | default: product.title }}"
          class="product-gallery__main-img"
          width="900"
          loading="eager"
        >
      </div>

      {% if product.images.size > 1 %}
        <div class="product-gallery__thumbs">
          {% for image in product.images %}
            <button
              class="product-gallery__thumb {% if forloop.first %}product-gallery__thumb--active{% endif %}"
              data-src="{{ image | image_url: width: 900 }}"
              aria-label="View image {{ forloop.index }}"
            >
              {{ image | image_url: width: 150 | image_tag:
                 class: 'product-gallery__thumb-img',
                 alt: image.alt | default: product.title }}
            </button>
          {% endfor %}
        </div>
      {% endif %}

    </div>

    {% comment %} Product Info {% endcomment %}
    <div class="product-info">

      {% comment %} Breadcrumb {% endcomment %}
      <nav class="product-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span>/</span>
        {% if collection %}
          <a href="{{ collection.url }}">{{ collection.title }}</a>
          <span>/</span>
        {% endif %}
        <span>{{ product.title }}</span>
      </nav>

      {% if product.vendor %}
        <p class="product-info__vendor">{{ product.vendor }}</p>
      {% endif %}

      <h1 class="product-info__title">{{ product.title }}</h1>

      {% comment %} Star rating placeholder {% endcomment %}
      <div class="product-info__rating" aria-label="4.5 out of 5 stars">
        <div class="product-info__stars">
          {% for i in (1..5) %}
            <svg class="star-icon" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.27l-4.77 2.44.91-5.32L2.27 6.62l5.34-.78z"/>
            </svg>
          {% endfor %}
        </div>
        <span class="product-info__review-count">(24 reviews)</span>
      </div>

      {% comment %} Price {% endcomment %}
      <div class="product-info__price-wrapper">
        {% if current_variant.compare_at_price > current_variant.price %}
          <span class="product-info__price--original">{{ current_variant.compare_at_price | money }}</span>
          <span class="product-info__price--sale">{{ current_variant.price | money }}</span>
          <span class="product-info__badge">Sale</span>
        {% else %}
          <span class="product-info__price">{{ current_variant.price | money }}</span>
        {% endif %}
      </div>

      {% comment %} Form {% endcomment %}
      {% form 'product', product %}

        {% if product.variants.size > 1 %}
          <div class="product-info__variants">
            <label class="product-info__label" for="variant-select">
              {{ section.settings.variant_label }}
            </label>
            <select name="id" id="variant-select" class="product-info__select">
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  {% if variant == current_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }} — {{ variant.price | money }}
                  {% unless variant.available %} (Sold Out){% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endif %}

        {% comment %} Quantity stepper {% endcomment %}
        <div class="product-info__quantity">
          <label class="product-info__label" for="quantity">{{ section.settings.quantity_label }}</label>
          <div class="quantity-stepper">
            <button type="button" class="quantity-stepper__btn" onclick="
              var i = document.getElementById('quantity');
              if(parseInt(i.value) > 1) i.value = parseInt(i.value) - 1;
            " aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" id="quantity" min="1" value="1" class="quantity-stepper__input">
            <button type="button" class="quantity-stepper__btn" onclick="
              var i = document.getElementById('quantity');
              i.value = parseInt(i.value) + 1;
            " aria-label="Increase quantity">+</button>
          </div>
        </div>

        {% comment %} Add to cart button {% endcomment %}
        <div class="product-info__actions" id="product-atc-anchor">
          {% if current_variant.available %}
            <button type="submit" name="add" class="btn btn--primary btn--full">
              {{ section.settings.button_label }}
            </button>
          {% else %}
            <button type="button" class="btn btn--primary btn--full" disabled>
              Sold Out
            </button>
          {% endif %}
        </div>

      {% endform %}

      {% comment %} Trust badges {% endcomment %}
      <div class="product-info__trust">
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Free Returns</span>
        </div>
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          <span>Secure Checkout</span>
        </div>
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
          <span>Fast Shipping</span>
        </div>
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          <span>Quality Guarantee</span>
        </div>
      </div>

      {% comment %} Accordions {% endcomment %}
      {% if product.description != blank %}
        <details class="product-accordion" open>
          <summary class="product-accordion__trigger">Description</summary>
          <div class="product-accordion__content">
            {{ product.description }}
          </div>
        </details>
      {% endif %}

      <details class="product-accordion">
        <summary class="product-accordion__trigger">Shipping & Returns</summary>
        <div class="product-accordion__content">
          {{ section.settings.shipping_text }}
        </div>
      </details>

    </div>
  </div>
</div>

{% comment %} Sticky ATC bar — mobile {% endcomment %}
<div class="sticky-atc" id="sticky-atc" aria-hidden="true">
  <div class="sticky-atc__inner">
    <div class="sticky-atc__info">
      <span class="sticky-atc__title">{{ product.title }}</span>
      <span class="sticky-atc__price">{{ current_variant.price | money }}</span>
    </div>
    {% form 'product', product %}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" name="add" class="btn btn--primary">
        {{ section.settings.button_label }}
      </button>
    {% endform %}
  </div>
</div>

<script>
  // Thumbnail switcher
  document.querySelectorAll('.product-gallery__thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      document.getElementById('product-main-image').src = this.dataset.src;
      document.querySelectorAll('.product-gallery__thumb').forEach(function(t) {
        t.classList.remove('product-gallery__thumb--active');
      });
      this.classList.add('product-gallery__thumb--active');
    });
  });

  // Sticky ATC — show when main button scrolls out of view
  var anchor = document.getElementById('product-atc-anchor');
  var stickyBar = document.getElementById('sticky-atc');
  if (anchor && stickyBar) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) {
          stickyBar.classList.add('sticky-atc--visible');
          stickyBar.setAttribute('aria-hidden', 'false');
        } else {
          stickyBar.classList.remove('sticky-atc--visible');
          stickyBar.setAttribute('aria-hidden', 'true');
        }
      });
    });
    observer.observe(anchor);
  }
</script>

{% stylesheet %}
  .product-page {
    padding: var(--section-spacing) var(--page-margin);
  }

  .product-page__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  @media (max-width: 768px) {
    .product-page__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  /* Gallery */
  .product-gallery__main {
    border-radius: var(--radius-card);
    overflow: hidden;
    background-color: var(--color-subtle);
    aspect-ratio: 1;
  }

  .product-gallery__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-gallery__thumbs {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }

  .product-gallery__thumb {
    border: 2px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: none;
    transition: border-color var(--transition-fast);
    width: 72px;
    height: 72px;
  }

  .product-gallery__thumb--active,
  .product-gallery__thumb:hover {
    border-color: var(--color-primary);
  }

  .product-gallery__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Breadcrumb */
  .product-breadcrumb {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--font-size-xs);
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }

  .product-breadcrumb a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .product-breadcrumb a:hover {
    color: var(--color-foreground);
  }

  /* Vendor */
  .product-info__vendor {
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: var(--space-2);
  }

  /* Title */
  .product-info__title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-4);
  }

  /* Rating */
  .product-info__rating {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .product-info__stars {
    display: flex;
    gap: 2px;
  }

  .star-icon {
    width: 16px;
    height: 16px;
    fill: var(--color-accent);
    color: var(--color-accent);
  }

  .product-info__review-count {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  /* Price */
  .product-info__price-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .product-info__price {
    font-size: var(--font-size-xl);
    font-weight: 600;
  }

  .product-info__price--original {
    font-size: var(--font-size-lg);
    color: var(--color-muted);
    text-decoration: line-through;
  }

  .product-info__price--sale {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-sale);
  }

  .product-info__badge {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    background-color: var(--color-sale);
    color: #fff;
    padding: 3px 8px;
    border-radius: var(--radius-input);
  }

  /* Label */
  .product-info__label {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  /* Variants */
  .product-info__variants {
    margin-bottom: var(--space-5);
  }

  .product-info__select {
    width: 100%;
    padding: 12px var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    font-size: var(--font-size-md);
    appearance: auto;
  }

  /* Quantity stepper */
  .product-info__quantity {
    margin-bottom: var(--space-5);
  }

  .quantity-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    overflow: hidden;
  }

  .quantity-stepper__btn {
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    font-size: var(--font-size-lg);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-foreground);
    transition: background-color var(--transition-fast);
  }

  .quantity-stepper__btn:hover {
    background-color: var(--color-subtle);
  }

  .quantity-stepper__input {
    width: 56px;
    height: 44px;
    text-align: center;
    border: none;
    border-left: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    font-size: var(--font-size-md);
    -moz-appearance: textfield;
  }

  .quantity-stepper__input::-webkit-outer-spin-button,
  .quantity-stepper__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
  }

  /* Actions */
  .product-info__actions {
    margin-bottom: var(--space-6);
  }

  /* Trust badges */
  .product-info__trust {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-muted);
  }

  .trust-badge svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  /* Accordions */
  .product-accordion {
    border-bottom: 1px solid var(--color-border);
  }

  .product-accordion:first-of-type {
    border-top: none;
  }

  .product-accordion__trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) 0;
    font-size: var(--font-size-md);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .product-accordion__trigger::-webkit-details-marker {
    display: none;
  }

  .product-accordion__trigger::after {
    content: '+';
    font-size: var(--font-size-lg);
    font-weight: 300;
    transition: transform var(--transition-fast);
  }

  .product-accordion[open] .product-accordion__trigger::after {
    content: '−';
  }

  .product-accordion__content {
    padding-bottom: var(--space-5);
    font-size: var(--font-size-md);
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* Sticky ATC */
  .sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 500;
    background-color: var(--color-background);
    border-top: 1px solid var(--color-border);
    padding: var(--space-3) var(--page-margin);
    transform: translateY(100%);
    transition: transform var(--transition-base);
    box-shadow: var(--shadow-lg);
    display: none;
  }

  .sticky-atc--visible {
    transform: translateY(0);
  }

  .sticky-atc__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .sticky-atc__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sticky-atc__title {
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .sticky-atc__price {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .sticky-atc {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "text",
      "id": "variant_label",
      "label": "Variant Label",
      "default": "Select Option"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity Label",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to Cart Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Shipping & Returns Text",
      "default": "<p>Free standard shipping on orders over £50. Returns accepted within 30 days of purchase. Items must be unworn and in original condition.</p>"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
