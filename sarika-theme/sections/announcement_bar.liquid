{% if section.settings.show_bar %}
  <div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="announcement-bar__text">
        {{ section.settings.message }}
      </a>
    {% else %}
      <p class="announcement-bar__text">{{ section.settings.message }}</p>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    width: 100%;
    padding: 10px var(--page-margin);
    text-align: center;
  }

  .announcement-bar__text {
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
  }

  .announcement-bar__text:hover {
    opacity: 0.8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Free UK shipping on orders over £50 — Use code SAVE20"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
