<div class="featured-products" style="background-color: {{ section.settings.background_color }}; padding: {{ section.settings.section_padding }}px var(--page-margin);">
  <div class="featured-products__inner">

    <div class="section-header">
      {% if section.settings.eyebrow != blank %}
        <span class="section-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="section-header__title">{{ section.settings.heading }}</h2>
      {% if section.settings.subtext != blank %}
        <p class="section-header__subtitle">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    {% assign collection = section.settings.collection %}

    {% if collection != blank %}
      <div class="products-grid">
        {% for product in collection.products limit: section.settings.products_count %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p class="featured-products__empty">Select a collection in the theme editor to display products.</p>
    {% endif %}

    {% if section.settings.view_all_label != blank and collection != blank %}
      <div class="featured-products__footer">
        <a href="{{ collection.url }}" class="btn btn--ghost">
          {{ section.settings.view_all_label }}
        </a>
      </div>
    {% endif %}

  </div>
</div>

{% stylesheet %}
  .featured-products__inner {
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-6);
  }

  .featured-products__footer {
    text-align: center;
    margin-top: var(--space-12);
  }

  .featured-products__empty {
    text-align: center;
    color: var(--color-muted);
  }

  @media (max-width: 480px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Handpicked For You"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Label",
      "default": "View All Products"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding (px)",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
